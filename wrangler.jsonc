{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "physicshead-learn",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // เว็บ React เป็น SPA: path ที่ไม่ใช่ไฟล์ให้ส่ง index.html, ส่วน /api/* ให้ Worker ตอบก่อน
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "physicshead-learn",
      // แทนที่ด้วย id จริงจากคำสั่ง `npx wrangler d1 create physicshead-learn` ก่อน deploy
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      // สร้างด้วย `npx wrangler r2 bucket create physicshead-learn-files` ก่อน deploy
      "bucket_name": "physicshead-learn-files"
    }
  ],
  "observability": { "enabled": true }
}
